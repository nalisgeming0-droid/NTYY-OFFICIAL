<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NTYY OFFICIAL - Premium Digital Store</title>
  <!-- FontAwesome Icons & Google Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-dark: #07090e;
      --card-bg: #121824;
      --card-border: rgba(99, 102, 241, 0.25);
      --primary: #6366f1;
      --primary-glow: #818cf8;
      --accent-cyan: #06b6d4;
      --accent-pink: #ec4899;
      --accent-gold: #f59e0b;
      --success: #10b981;
      --danger: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --radius: 14px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.15) 0%, transparent 35%),
        radial-gradient(circle at 85% 85%, rgba(236, 72, 153, 0.15) 0%, transparent 35%);
      background-attachment: fixed;
    }

    /* Navbar */
    .navbar {
      background: rgba(18, 24, 36, 0.85);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--card-border);
    }
    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 14px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.3rem;
      font-weight: 800;
    }
    .logo-box {
      background: linear-gradient(135deg, var(--primary), var(--accent-pink));
      color: #fff;
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
    }
    .highlight { color: var(--accent-cyan); }
    .btn-admin {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      padding: 8px 16px;
      border-radius: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 0.85rem;
      transition: 0.3s;
    }
    .btn-admin:hover {
      background: var(--primary);
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
    }

    /* Hero Header */
    .hero-banner {
      padding: 50px 20px 30px;
      text-align: center;
      max-width: 900px;
      margin: 0 auto;
    }
    .top-badge {
      display: inline-block;
      background: linear-gradient(90deg, rgba(236, 72, 153, 0.2), rgba(99, 102, 241, 0.2));
      border: 1px solid var(--accent-pink);
      color: #fff;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 15px;
    }
    .hero-banner h1 {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 12px;
    }
    .text-gradient {
      background: linear-gradient(90deg, var(--accent-cyan), var(--accent-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-banner p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Layout Main */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px 20px 50px;
    }

    /* Category Filter Tabs */
    .category-wrapper {
      overflow-x: auto;
      padding-bottom: 10px;
      margin-bottom: 30px;
    }
    .category-tabs {
      display: flex;
      gap: 12px;
      min-width: max-content;
    }
    .tab-btn {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      padding: 10px 20px;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: 0.3s;
    }
    .tab-btn.active, .tab-btn:hover {
      background: linear-gradient(135deg, var(--primary), #4f46e5);
      color: #fff;
      border-color: transparent;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }

    /* Product Cards Grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 22px;
    }
    .product-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .product-card:hover {
      transform: translateY(-6px);
      border-color: var(--primary-glow);
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.25);
    }
    .product-img-box {
      width: 100%;
      height: 150px;
      background: #0b0f17;
      position: relative;
    }
    .product-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .card-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      background: linear-gradient(135deg, var(--accent-pink), #c026d3);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 6px;
    }
    .product-details {
      padding: 18px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: space-between;
    }
    .product-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: #fff;
    }
    .product-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 15px;
      line-height: 1.4;
    }
    .btn-buy-card {
      width: 100%;
      background: linear-gradient(90deg, var(--accent-cyan), var(--primary));
      color: #fff;
      border: none;
      padding: 12px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: 0.3s;
    }
    .btn-buy-card:hover {
      opacity: 0.9;
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.5);
    }

    /* Modals */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .glass-card {
      background: #101622;
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 25px;
      width: 100%;
      max-width: 480px;
      position: relative;
      box-shadow: 0 15px 35px rgba(0,0,0,0.6);
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal-sm { max-width: 380px; }
    .modal-lg { max-width: 700px; }
    .close-btn {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 1.6rem;
      color: var(--text-muted);
      cursor: pointer;
    }
    .modal-header-title {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .modal-header-title i {
      font-size: 1.5rem;
      color: var(--accent-cyan);
    }
    .modal-header-title h2 { font-size: 1.2rem; font-weight: 700; }
    .modal-header-title p { font-size: 0.8rem; color: var(--text-muted); }

    /* Forms */
    .form-group { margin-bottom: 15px; }
    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: #cbd5e1;
    }
    .form-group input, .form-group textarea, .custom-select {
      width: 100%;
      padding: 11px 14px;
      background: #090d14;
      border: 1px solid var(--card-border);
      color: #fff;
      border-radius: 8px;
      outline: none;
      font-size: 0.85rem;
    }
    .form-group input:focus, .form-group textarea:focus, .custom-select:focus {
      border-color: var(--primary-glow);
    }

    /* Price Box */
    .price-summary-box {
      background: rgba(255, 255, 255, 0.03);
      border: 1px dashed var(--card-border);
      padding: 14px;
      border-radius: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 20px 0;
      font-weight: 700;
    }
    .total-amount { font-size: 1.3rem; color: var(--accent-cyan); }
    .btn-pay-now {
      width: 100%;
      background: linear-gradient(135deg, var(--primary), var(--accent-pink));
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 10px;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* Step 2 QRIS */
    .qris-display-box {
      text-align: center;
      background: #090d14;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--card-border);
      margin-bottom: 15px;
    }
    .qris-display-box img {
      width: 220px;
      height: 220px;
      object-fit: contain;
      background: #fff;
      padding: 10px;
      border-radius: 10px;
      margin-bottom: 12px;
    }
    .status-box {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid var(--accent-gold);
      color: var(--accent-gold);
      padding: 10px;
      border-radius: 8px;
      text-align: center;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .action-buttons { display: flex; gap: 10px; }
    .btn-verify {
      flex: 2;
      background: var(--success);
      color: #fff;
      border: none;
      padding: 12px;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-cancel {
      flex: 1;
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-muted);
      border: none;
      padding: 12px;
      border-radius: 8px;
      cursor: pointer;
    }

    /* Step 3 Receipt */
    .success-banner { text-align: center; margin-bottom: 20px; }
    .success-icon { font-size: 3rem; color: var(--success); margin-bottom: 10px; }
    .receipt-card {
      background: #090d14;
      border: 1px solid var(--card-border);
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
    }
    .receipt-row { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; }
    .receipt-row span { color: var(--text-muted); }
    .badge-success { background: rgba(16, 185, 129, 0.2); color: var(--success); padding: 2px 8px; border-radius: 4px; font-weight: bold; }
    .btn-wa-send {
      display: block;
      width: 100%;
      text-align: center;
      background: #25d366;
      color: #fff;
      text-decoration: none;
      padding: 14px;
      border-radius: 10px;
      font-weight: 800;
      font-size: 0.9rem;
    }

    /* Admin Styling */
    .admin-sections { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 650px) { .admin-sections { grid-template-columns: 1fr; } }
    .admin-card { background: #090d14; border: 1px solid var(--card-border); padding: 15px; border-radius: 10px; }
    .admin-card h3 { font-size: 0.95rem; margin-bottom: 12px; color: var(--accent-cyan); }
    .qris-preview-box img { width: 120px; height: 120px; object-fit: contain; background: #fff; padding: 4px; border-radius: 6px; margin-top: 8px; }

    footer {
      text-align: center;
      padding: 30px 20px;
      border-top: 1px solid var(--card-border);
      background: rgba(18, 24, 36, 0.5);
      margin-top: 40px;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="logo">
        <div class="logo-box"><i class="fa-solid fa-bolt"></i></div>
        <span>NTYY <span class="highlight">OFFICIAL</span></span>
      </div>
      <div class="nav-actions">
        <button id="admin-login-btn" class="btn-admin" title="Admin Panel">
          <i class="fa-solid fa-user-shield"></i> <span>Admin</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero Header -->
  <header class="hero-banner">
    <span class="top-badge"><i class="fa-solid fa-fire"></i> Official Digital Marketplace</span>
    <h1>Pusat Layanan Game & Sosmed <span class="text-gradient">Tercepat & Terpercaya</span></h1>
    <p>Nikmati kemudahan transaksi instan dengan QRIS Otomatis. Aman, Cepat, dan Bergaransi ⚡</p>
  </header>

  <!-- Main Container -->
  <main class="container">
    
    <!-- Category Filter -->
    <div class="category-wrapper">
      <div class="category-tabs">
        <button class="tab-btn active" onclick="filterCategory('all', this)"><i class="fa-solid fa-border-all"></i> Semua</button>
        <button class="tab-btn" onclick="filterCategory('roblox', this)"><i class="fa-solid fa-gamepad"></i> Verif Roblox</button>
        <button class="tab-btn" onclick="filterCategory('joki', this)"><i class="fa-solid fa-trophy"></i> Joki Game</button>
        <button class="tab-btn" onclick="filterCategory('nokos', this)"><i class="fa-solid fa-sim-card"></i> Ready Nokos</button>
        <button class="tab-btn" onclick="filterCategory('sosmed', this)"><i class="fa-solid fa-rocket"></i> Suntik Sosmed</button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-grid" id="product-container"></div>

  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 <strong>NTYY OFFICIAL</strong>. All Rights Reserved.</p>
  </footer>

  <!-- MODAL CHECKOUT & PAYMENT -->
  <div id="checkout-modal" class="modal">
    <div class="modal-content glass-card">
      <span class="close-btn" onclick="closeModal('checkout-modal')">&times;</span>
      
      <!-- Step 1: Input Data -->
      <div id="checkout-step-1">
        <div class="modal-header-title">
          <i class="fa-solid fa-cart-shopping"></i>
          <div>
            <h2>Detail Pesanan</h2>
            <p id="modal-product-title">Nama Produk</p>
          </div>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-list"></i> Pilih Paket / Varian</label>
          <select id="modal-variant-select" class="custom-select" onchange="updateModalPrice()"></select>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-user"></i> Nama / Username Kamu</label>
          <input type="text" id="buyer-name" placeholder="Contoh: Alex123" required />
        </div>

        <div class="form-group">
          <label><i class="fa-brands fa-whatsapp"></i> Nomor WhatsApp Active</label>
          <input type="tel" id="buyer-phone" placeholder="08xxxxxxxxxx" required />
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-link"></i> Target / Catatan (Username / Link Profile)</label>
          <textarea id="buyer-note" rows="2" placeholder="Masukkan ID Roblox, Link IG, atau catatan tambahan"></textarea>
        </div>

        <div class="price-summary-box">
          <span>Total Pembayaran:</span>
          <span id="modal-total-price" class="total-amount">Rp0</span>
        </div>

        <button onclick="goToPaymentStep()" class="btn-pay-now">
          <i class="fa-solid fa-qrcode"></i> Lanjut Ke Pembayaran QRIS
        </button>
      </div>

      <!-- Step 2: QRIS Display & Checking -->
      <div id="checkout-step-2" style="display: none;">
        <div class="modal-header-title">
          <i class="fa-solid fa-qrcode"></i>
          <div>
            <h2>Scan Pembayaran QRIS</h2>
            <p>Selesaikan pembayaran sebelum waktu habis</p>
          </div>
        </div>

        <div class="qris-display-box">
          <img id="qris-image-view" src="" alt="QRIS NTYY OFFICIAL" />
          <div style="font-size:1.1rem; color:#fff;">Total: <strong id="qris-total-amount">Rp0</strong></div>
        </div>

        <div class="status-box" id="payment-status-box">
          <i class="fa-solid fa-spinner fa-spin status-icon" id="status-icon"></i>
          <span id="status-text">Menunggu Pembayaran...</span>
        </div>

        <div class="action-buttons">
          <button id="btn-check-payment" onclick="verifyPaymentSimulation()" class="btn-verify">
            <i class="fa-solid fa-circle-check"></i> Saya Sudah Bayar (Cek Otomatis)
          </button>
          <button onclick="cancelPayment()" class="btn-cancel">Batal</button>
        </div>
      </div>

      <!-- Step 3: Success Receipt -->
      <div id="checkout-step-3" style="display: none;">
        <div class="success-banner">
          <i class="fa-solid fa-circle-check success-icon"></i>
          <h2>PEMBAYARAN BERHASIL!</h2>
          <p>Pesanan Anda telah dikonfirmasi oleh sistem.</p>
        </div>

        <div class="receipt-card">
          <div class="receipt-row"><span>No. Transaksi:</span> <strong id="rec-trx-id">NTYY-0000</strong></div>
          <div class="receipt-row"><span>Produk:</span> <strong id="rec-product">-</strong></div>
          <div class="receipt-row"><span>Paket:</span> <strong id="rec-variant">-</strong></div>
          <div class="receipt-row"><span>Total Bayar:</span> <strong id="rec-price">Rp0</strong></div>
          <div class="receipt-row"><span>Status:</span> <span class="badge-success">LUNAS / BERHASIL</span></div>
        </div>

        <a id="btn-send-wa" href="#" target="_blank" class="btn-wa-send">
          <i class="fa-brands fa-whatsapp"></i> Kirim Bukti Pesanan Ke Admin (6283174257580)
        </a>
      </div>

    </div>
  </div>

  <!-- MODAL ADMIN LOGIN -->
  <div id="admin-login-modal" class="modal">
    <div class="modal-content glass-card modal-sm">
      <span class="close-btn" onclick="closeModal('admin-login-modal')">&times;</span>
      <h2><i class="fa-solid fa-lock"></i> Login Admin Panel</h2>
      <p style="color:#94a3b8; font-size:0.85rem; margin-bottom:15px;">Khusus Pemilik NTYY OFFICIAL</p>
      <div class="form-group">
        <label>Kode Sandi Rahasia</label>
        <input type="password" id="admin-pass-input" placeholder="Masukkan Kode Sandi" />
      </div>
      <button onclick="checkAdminPassword()" class="btn-pay-now">Masuk Panel</button>
    </div>
  </div>

  <!-- MODAL ADMIN PANEL -->
  <div id="admin-panel-modal" class="modal">
    <div class="modal-content glass-card modal-lg">
      <span class="close-btn" onclick="closeModal('admin-panel-modal')">&times;</span>
      <h2><i class="fa-solid fa-sliders"></i> Panel Kelola Toko & QRIS</h2>
      
      <div class="admin-sections">
        
        <!-- Setting QRIS -->
        <div class="admin-card">
          <h3>1. Upload QRIS Dari Galeri HP/PC</h3>
          <div class="form-group">
            <label><i class="fa-brands fa-whatsapp"></i> WhatsApp Tujuan</label>
            <input type="text" value="6283174257580" readonly />
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-image"></i> Pilih Gambar QRIS Dari Galeri</label>
            <input type="file" id="admin-qris-file" accept="image/*" onchange="previewQRISUpload(event)" />
            <div class="qris-preview-box">
              <img id="admin-qris-preview" src="" alt="Preview QRIS" />
            </div>
          </div>
          <button onclick="saveAdminSettings()" class="btn-pay-now"><i class="fa-solid fa-floppy-disk"></i> Simpan QRIS Baru</button>
        </div>

        <!-- Tambah Produk -->
        <div class="admin-card">
          <h3>2. Tambah Produk Baru + Foto Galeri</h3>
          <div class="form-group">
            <label>Nama Produk</label>
            <input type="text" id="new-prod-title" placeholder="Contoh: Premium Roblox" />
          </div>
          <div class="form-group">
            <label>Kategori</label>
            <select id="new-prod-cat" class="custom-select">
              <option value="roblox">Verif Roblox</option>
              <option value="joki">Joki Game</option>
              <option value="nokos">Ready Nokos</option>
              <option value="sosmed">Suntik Sosmed</option>
            </select>
          </div>
          <div class="form-group">
            <label>Foto Produk (Dari Galeri)</label>
            <input type="file" id="new-prod-img" accept="image/*" />
          </div>
          <div class="form-group">
            <label>Varian & Harga (Format: Paket = Harga)</label>
            <textarea id="new-prod-variants" rows="3" placeholder="Paket 100 Diamond = 10000&#10;Paket 500 Diamond = 45000"></textarea>
          </div>
          <button onclick="addNewProduct()" class="btn-pay-now"><i class="fa-solid fa-plus"></i> Tambahkan Ke Toko</button>
        </div>

      </div>
    </div>
  </div>

  <script>
    // CONFIGURATION & DEFAULT DATA
    const ADMIN_PASS = "41038nsfakish";
    const DEFAULT_WA = "6283174257580";
    const DEFAULT_QRIS = "https://via.placeholder.com/300x300.png?text=SCAN+QRIS+NTYY+OFFICIAL";

    let storeQRIS = localStorage.getItem("ntyy_qris_image") || DEFAULT_QRIS;

    const defaultProducts = [
      {
        id: "prod-roblox-1",
        category: "roblox",
        title: "DAFTAR VERIF ROBLOX",
        description: "Akun Verif Polosan. Bisa tanpa login akun! Proses kilat & terpercaya.",
        image: "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?w=500&auto=format&fit=crop&q=60",
        badge: "🎮 POPULER",
        variants: [
          { name: "Verif umur 16+", price: 7000 },
          { name: "Verif umur 18+", price: 14000 },
          { name: "Verif umur 20+", price: 25000 },
          { name: "Verif umur 25+", price: 27000 },
          { name: "Verif umur 30+", price: 44000 }
        ]
      },
      {
        id: "prod-joki-1",
        category: "joki",
        title: "JASA JOKI STEAL A EGG",
        description: "Bantu AFK Treadmill, Divine, & Internal. Dikerjakan semaksimal mungkin!",
        image: "https://images.unsplash.com/photo-1542751371-adc38448a05e?w=500&auto=format&fit=crop&q=60",
        badge: "🔥 HOT JOKI",
        variants: [
          { name: "Joki 3 Hari", price: 12000 },
          { name: "Joki 5 Hari", price: 15000 },
          { name: "Joki 7 Hari", price: 25000 }
        ]
      },
      {
        id: "prod-nokos-1",
        category: "nokos",
        title: "READY NOKOS (Nomor Kosong)",
        description: "Nokos Luar Negeri & Indonesia. Fast Proses & Langsung Siap Pakai!",
        image: "https://images.unsplash.com/photo-1563986768609-322da13575f3?w=500&auto=format&fit=crop&q=60",
        badge: "📲 INSTAN",
        variants: [
          { name: "🇮🇩 Indonesia", price: 6000 },
          { name: "🇵🇭 Philippines", price: 8000 },
          { name: "🇲🇾 Malaysia", price: 95000 },
          { name: "🇯🇵 Jepang", price: 15000 },
          { name: "🇦🇷 Argentina", price: 8000 },
          { name: "🇬🇧 United Kingdom", price: 10000 },
          { name: "🇨🇦 Canada", price: 9000 },
          { name: "🇻🇳 Vietnam", price: 8000 },
          { name: "🇰🇪 Kenya", price: 7000 },
          { name: "🇨🇱 Chile", price: 9000 },
          { name: "🇸🇦 Saudi Arabia", price: 12000 }
        ]
      },
      {
        id: "prod-sosmed-1",
        category: "sosmed",
        title: "SUNTIK SOSMED NSL (IG & TIKTOK)",
        description: "Followers, Likes, & Views Instagram/TikTok. Proses 1-15 Menit Aman!",
        image: "https://images.unsplash.com/photo-1611162617474-5b21e879e113?w=500&auto=format&fit=crop&q=60",
        badge: "🚀 FAST BOOST",
        variants: [
          { name: "1.000 Pengikut Saluran", price: 7000 },
          { name: "1.000 Followers IG", price: 20000 },
          { name: "10.000 Views IG", price: 20000 },
          { name: "1.000 Likes IG", price: 10000 },
          { name: "1.000 Likes TikTok", price: 50000 },
          { name: "50.000 Views TikTok", price: 80000 },
          { name: "1.000 Followers TikTok", price: 70000 }
        ]
      }
    ];

    let products = JSON.parse(localStorage.getItem("ntyy_products")) || defaultProducts;
    let activeProduct = null;
    let currentTrxId = "";

    function formatRupiah(val) { return "Rp" + val.toLocaleString("id-ID"); }

    function renderProducts(category = "all") {
      const container = document.getElementById("product-container");
      container.innerHTML = "";

      const filtered = category === "all" ? products : products.filter(p => p.category === category);

      filtered.forEach(item => {
        const card = document.createElement("div");
        card.className = "product-card";
        card.innerHTML = `
          <div class="product-img-box">
            <img src="${item.image}" alt="${item.title}" />
            <span class="card-badge">${item.badge || 'STORE'}</span>
          </div>
          <div class="product-details">
            <div>
              <h3 class="product-title">${item.title}</h3>
              <p class="product-desc">${item.description}</p>
            </div>
            <button class="btn-buy-card" onclick="openCheckoutModal('${item.id}')">
              <i class="fa-solid fa-cart-shopping"></i> Beli Sekarang
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterCategory(cat, element) {
      document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("active"));
      element.classList.add("active");
      renderProducts(cat);
    }

    function openCheckoutModal(productId) {
      activeProduct = products.find(p => p.id === productId);
      if(!activeProduct) return;

      document.getElementById("modal-product-title").innerText = activeProduct.title;
      const select = document.getElementById("modal-variant-select");
      select.innerHTML = "";
      activeProduct.variants.forEach((v, index) => {
        const opt = document.createElement("option");
        opt.value = index;
        opt.innerText = `${v.name} - ${formatRupiah(v.price)}`;
        select.appendChild(opt);
      });

      document.getElementById("checkout-step-1").style.display = "block";
      document.getElementById("checkout-step-2").style.display = "none";
      document.getElementById("checkout-step-3").style.display = "none";

      updateModalPrice();
      document.getElementById("checkout-modal").style.display = "flex";
    }

    function updateModalPrice() {
      const selectIndex = document.getElementById("modal-variant-select").value;
      const variant = activeProduct.variants[selectIndex];
      document.getElementById("modal-total-price").innerText = formatRupiah(variant.price);
    }

    function goToPaymentStep() {
      const buyerName = document.getElementById("buyer-name").value.trim();
      const buyerPhone = document.getElementById("buyer-phone").value.trim();

      if(!buyerName || !buyerPhone) {
        alert("⚠️ Isi Nama dan Nomor WhatsApp terlebih dahulu!");
        return;
      }

      const selectIndex = document.getElementById("modal-variant-select").value;
      const selectedVariant = activeProduct.variants[selectIndex];

      document.getElementById("qris-image-view").src = storeQRIS;
      document.getElementById("qris-total-amount").innerText = formatRupiah(selectedVariant.price);

      document.getElementById("checkout-step-1").style.display = "none";
      document.getElementById("checkout-step-2").style.display = "block";
    }

    function verifyPaymentSimulation() {
      const statusText = document.getElementById("status-text");
      const statusIcon = document.getElementById("status-icon");

      statusText.innerText = "Memeriksa Pembayaran...";
      statusIcon.className = "fa-solid fa-arrows-rotate fa-spin status-icon";

      setTimeout(() => {
        currentTrxId = "NTYY-" + Math.floor(100000 + Math.random() * 900000);
        const selectIndex = document.getElementById("modal-variant-select").value;
        const selectedVariant = activeProduct.variants[selectIndex];
        const buyerName = document.getElementById("buyer-name").value.trim();
        const buyerNote = document.getElementById("buyer-note").value.trim() || "-";

        document.getElementById("rec-trx-id").innerText = currentTrxId;
        document.getElementById("rec-product").innerText = activeProduct.title;
        document.getElementById("rec-variant").innerText = selectedVariant.name;
        document.getElementById("rec-price").innerText = formatRupiah(selectedVariant.price);

        const waMsg = `*BUKTI PEMBAYARAN BERHASIL - NTYY OFFICIAL* ⚡
        
• *No Transaksi:* ${currentTrxId}
• *Nama Pembeli:* ${buyerName}
• *Produk:* ${activeProduct.title}
• *Paket/Varian:* ${selectedVariant.name}
• *Total Bayar:* ${formatRupiah(selectedVariant.price)}
• *Catatan/Target:* ${buyerNote}
• *Status:* DIBAYAR (SUKSES)

Halo Admin, mohon segera diproses ya! Terima kasih.`;

        document.getElementById("btn-send-wa").href = `https://wa.me/${DEFAULT_WA}?text=${encodeURIComponent(waMsg)}`;

        document.getElementById("checkout-step-2").style.display = "none";
        document.getElementById("checkout-step-3").style.display = "block";
      }, 1500);
    }

    function cancelPayment() {
      document.getElementById("checkout-step-2").style.display = "none";
      document.getElementById("checkout-step-1").style.display = "block";
    }

    function closeModal(modalId) { document.getElementById(modalId).style.display = "none"; }

    document.getElementById("admin-login-btn").addEventListener("click", () => {
      document.getElementById("admin-login-modal").style.display = "flex";
    });

    function checkAdminPassword() {
      const pass = document.getElementById("admin-pass-input").value;
      if(pass === ADMIN_PASS) {
        alert("✅ Login Admin Berhasil!");
        closeModal("admin-login-modal");
        document.getElementById("admin-pass-input").value = "";
        document.getElementById("admin-qris-preview").src = storeQRIS;
        document.getElementById("admin-panel-modal").style.display = "flex";
      } else {
        alert("❌ Kode Sandi Admin Salah!");
      }
    }

    function previewQRISUpload(e) {
      const file = e.target.files[0];
      if(file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          document.getElementById("admin-qris-preview").src = evt.target.result;
        };
        reader.readAsDataURL(file);
      }
    }

    function saveAdminSettings() {
      const newQrisSrc = document.getElementById("admin-qris-preview").src;
      if(newQrisSrc) {
        storeQRIS = newQrisSrc;
        localStorage.setItem("ntyy_qris_image", newQrisSrc);
        alert("✨ Gambar QRIS Baru Berhasil Disimpan!");
        closeModal("admin-panel-modal");
      }
    }

    function addNewProduct() {
      const title = document.getElementById("new-prod-title").value.trim();
      const category = document.getElementById("new-prod-cat").value;
      const imgFile = document.getElementById("new-prod-img").files[0];
      const variantsText = document.getElementById("new-prod-variants").value.trim();

      if(!title || !variantsText) {
        alert("⚠️ Isi nama produk dan varian!");
        return;
      }

      const lines = variantsText.split("\n");
      const variants = [];
      lines.forEach(line => {
        const parts = line.split("=");
        if(parts.length === 2) {
          variants.push({ name: parts[0].trim(), price: parseInt(parts[1].trim()) || 0 });
        }
      });

      function createProduct(imgUrl) {
        const newProd = {
          id: "prod-custom-" + Date.now(),
          category: category,
          title: title,
          description: "Produk Baru Resmi NTYY OFFICIAL",
          image: imgUrl || "https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=500&auto=format&fit=crop&q=60",
          badge: "NEW",
          variants: variants
        };

        products.unshift(newProd);
        localStorage.setItem("ntyy_products", JSON.stringify(products));
        renderProducts();
        alert("🎉 Produk baru berhasil ditambahkan!");
        closeModal("admin-panel-modal");
      }

      if(imgFile) {
        const reader = new FileReader();
        reader.onload = function(evt) { createProduct(evt.target.result); };
        reader.readAsDataURL(imgFile);
      } else {
        createProduct(null);
      }
    }

    window.onclick = function(e) {
      if (e.target.classList.contains("modal")) {
        e.target.style.display = "none";
      }
    };

    renderProducts();
  </script>
